# Raahi Environment Variables Template
# Copy this file to .env or .env.local and fill in your values.
# NEVER commit .env or .env.local files containing real secrets to Git.

# Flask Core Configuration
FLASK_ENV=development
FLASK_DEBUG=1
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars

# Database Configuration (PostgreSQL in production; unset for local SQLite fallback)
# Example: postgresql://user:password@host.render.com:5432/raahi_db
DATABASE_URL=

# Admin Account Credentials (required for admin dashboard access)
ADMIN_EMAIL=admin@raahi.local
ADMIN_PASSWORD=change-to-a-secure-admin-password

# Third-Party API Keys (optional; features fallback gracefully when unset)
# Google Maps Directions & Geocoding API Key (falls back to OSRM and presets)
GOOGLE_MAPS_API_KEY=

# World Air Quality Index (WAQI) API Token (falls back to cached/regional values)
WAQI_API_TOKEN=

# Rate Limiter Backend (defaults to in-memory: memory://)
# For distributed / serverless production setups with Redis:
# RATELIMIT_STORAGE_URI=redis://username:password@redis-host:6379/0
RATELIMIT_STORAGE_URI=memory://
